{
  "name": "seo-bot",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check",
    "deploy": "astro build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply seo-bot --remote",
    "db:migrate:local": "wrangler d1 migrations apply seo-bot --local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.0",
    "@astrojs/sitemap": "^3.4.1",
    "astro": "^5.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^5.8.3",
    "wrangler": "^4.24.0"
  }
}
