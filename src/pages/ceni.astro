---
import BaseLayout from '../layouts/BaseLayout.astro';

const comparison = [
  ['Домейни', '1', '1', '10'],
  ['Проверки на AI видимост', '3 / месец', 'всеки ден', 'всеки ден'],
  ['AI двигатели', '1 двигател', '4 двигателя', '4 двигателя'],
  ['Ключови думи', '10', '500', '5 000'],
  ['Съобщения в чата', '50 / месец', 'без лимит', 'без лимит'],
  ['Одит на сайта', '100 URL', '10 000 URL', 'без лимит'],
  ['Search Console и Analytics', 'да', 'да', 'да'],
  ['Следене на конкуренти', null, '3', '10 на домейн'],
  ['Брандирани отчети', null, null, 'да'],
  ['API и webhooks', null, null, 'да'],
  ['Потребители в екипа', '1', '3', 'без лимит'],
  ['Поддръжка', 'имейл, 72 ч.', 'имейл, 24 ч.', 'приоритетна, 4 ч.'],
];

const faq = [
  {
    q: 'Какво е GEO и защо ми трябва?',
    a: 'Generative Engine Optimization е оптимизация за отговорите на AI моделите. Все повече хора получават готов отговор, вместо списък с връзки. Ако не си в отговора, не съществуваш.',
  },
  {
    q: 'Работи ли на български?',
    a: 'Да. Заявките, отговорите и генерираното съдържание са на български, а видимостта се мери отделно за български и английски запитвания.',
  },
  {
    q: 'Мога ли да сменя плана?',
    a: 'По всяко време. Разликата се начислява пропорционално, а при понижаване кредитът остава за следващия период.',
  },
  {
    q: 'Издавате ли фактури?',
    a: 'Да, автоматично с ДДС за регистрирани по ЗДДС фирми в ЕС. Плащане с карта или банков превод при годишен план.',
  },
  {
    q: 'Къде се съхраняват данните?',
    a: 'В центрове за данни в ЕС. Подписваме DPA и не използваме съдържанието ви за обучение на модели.',
  },
  {
    q: 'Има ли връщане на пари?',
    a: '14 дни без въпроси за първото плащане. Условията са в политиката за възстановяване.',
  },
];
---

<BaseLayout title="Цени" current="ceni" description="Планове Free, Pro и Business за следене на SEO и GEO видимост. Всички включват четирите AI двигателя, чат с бота и технически одит.">
  <div class="shell">
    <section style="padding: 80px 0 48px">
      <span class="kicker kicker-accent" style="margin-bottom: 24px">Цени</span>
      <h1 style="font-weight: 800; font-size: clamp(36px, 5vw, 64px); line-height: 1.06; letter-spacing: -0.02em; margin: 0 0 24px; margin-left: -0.058em">
        <span style="display: block">Плащаш за видимост,</span>
        <span style="display: block">не за табла с графики.</span>
      </h1>
      <p style="font-size: 18px; line-height: 1.65; max-width: 54ch; margin: 0 0 32px">
        Всички планове включват следене на AI двигателите, чат с бота, връзка със Search Console и Analytics
        и технически одит. Разликата е в обема и в екипните функции. Отказваш се когато решиш.
      </p>
      <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap">
        <div class="seg" role="group" aria-label="Период на плащане" id="period">
          <button type="button" class="seg-opt" aria-pressed="true" data-period="monthly">Месечно</button>
          <button type="button" class="seg-opt" aria-pressed="false" data-period="annual">Годишно</button>
        </div>
        <span style="font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent-700)">
          Годишно: два месеца безплатно
        </span>
      </div>
    </section>

    <section style="padding: 0 0 72px">
      <div class="split-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; align-items: start">
        <div style="border-top: 2px solid var(--color-text); padding: 24px 0 0">
          <p class="kicker" style="margin-bottom: 20px">Free</p>
          <p style="font-weight: 800; font-size: 44px; line-height: 1; letter-spacing: -0.02em; margin: 0 0 8px">0 лв.</p>
          <p style="font-size: 14px; line-height: 1.6; color: var(--color-neutral-700); margin: 0 0 24px">Завинаги. Без карта.</p>
          <p style="font-size: 15px; line-height: 1.7; margin: 0 0 24px; color: var(--color-neutral-800)">
            За да провериш дали AI изобщо знае за теб.
          </p>
          <a class="btn btn-ghost btn-block" href="/vhod/?view=register">Създай акаунт</a>
          <ul style="list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 10px; font-size: 14.5px; line-height: 1.6">
            <li>1 домейн</li>
            <li>3 проверки на видимост месечно</li>
            <li>10 ключови думи</li>
            <li>50 съобщения в чата месечно</li>
            <li>Одит до 100 URL адреса</li>
          </ul>
        </div>

        <div style="border-top: 2px solid var(--color-accent); padding: 24px 0 0">
          <p class="kicker kicker-accent" style="margin-bottom: 20px">Pro · най-избиран</p>
          <p style="font-weight: 800; font-size: 44px; line-height: 1; letter-spacing: -0.02em; margin: 0 0 8px" data-price-pro>149 лв.</p>
          <p style="font-size: 14px; line-height: 1.6; color: var(--color-neutral-700); margin: 0 0 24px" data-period-note>на месец, за домейн</p>
          <p style="font-size: 15px; line-height: 1.7; margin: 0 0 24px; color: var(--color-neutral-800)">
            За бранд, който иска да е отговорът, а не бележка под линия.
          </p>
          <a class="btn btn-primary btn-block" href="/vhod/?view=register" style="color: var(--color-bg)">Вземи Pro</a>
          <ul style="list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 10px; font-size: 14.5px; line-height: 1.6">
            <li>1 домейн + 3 конкурента</li>
            <li>Ежедневно следене, 4 двигателя</li>
            <li>500 ключови думи</li>
            <li>Чат без лимит + генериране на съдържание</li>
            <li>Одит до 10 000 URL адреса</li>
            <li>Задачи с приоритет и седмичен отчет</li>
            <li>Schema и llms.txt генератор</li>
          </ul>
        </div>

        <div style="border-top: 2px solid var(--color-text); padding: 24px 0 0">
          <p class="kicker" style="margin-bottom: 20px">Business</p>
          <p style="font-weight: 800; font-size: 44px; line-height: 1; letter-spacing: -0.02em; margin: 0 0 8px" data-price-biz>449 лв.</p>
          <p style="font-size: 14px; line-height: 1.6; color: var(--color-neutral-700); margin: 0 0 24px" data-period-note>на месец, за домейн</p>
          <p style="font-size: 15px; line-height: 1.7; margin: 0 0 24px; color: var(--color-neutral-800)">
            За агенции и екипи с повече от един клиент.
          </p>
          <a class="btn btn-ghost btn-block" href="/pravno/#contact">Говори с нас</a>
          <ul style="list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 10px; font-size: 14.5px; line-height: 1.6">
            <li>До 10 домейна, по 10 конкурента</li>
            <li>5 000 ключови думи</li>
            <li>Брандирани отчети (PDF, бял етикет)</li>
            <li>Екипни права и одит на действията</li>
            <li>API достъп и webhooks</li>
            <li>Поддръжка с отговор до 4 часа</li>
            <li>DPA и обработка в ЕС</li>
          </ul>
        </div>
      </div>
    </section>

    <hr class="rule" />

    <section style="padding: 64px 0">
      <span class="kicker kicker-accent" style="margin-bottom: 32px">Сравнение</span>
      <div style="overflow-x: auto">
        <table class="table">
          <thead>
            <tr><th style="width: 40%">Функция</th><th>Free</th><th>Pro</th><th>Business</th></tr>
          </thead>
          <tbody>
            {comparison.map((row) => (
              <tr>
                <td>{row[0]}</td>
                {row.slice(1).map((cell) => (
                  <td>{cell === null ? <span class="tag tag-outline">Не</span> : cell}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <hr class="rule" />

    <section style="padding: 64px 0">
      <span class="kicker kicker-accent" style="margin-bottom: 40px">Често задавани въпроси</span>
      <div class="split-2" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 64px">
        {faq.map((item) => (
          <div>
            <h3 style="font-weight: 800; font-size: 19px; line-height: 1.3; margin: 0 0 12px">{item.q}</h3>
            <p style="font-size: 15px; line-height: 1.7; margin: 0; color: var(--color-neutral-800)">{item.a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>

  <section style="background: var(--color-accent); color: var(--color-bg)">
    <div class="shell" style="padding-block: 84px">
      <h3 style="font-weight: 800; font-size: clamp(32px, 4.2vw, 56px); line-height: 1.06; letter-spacing: -0.015em; margin: 0 0 40px; margin-left: -0.058em">
        <span style="display: block">Първата проверка отнема 12 минути.</span>
        <span style="display: block">Започни с Free.</span>
      </h3>
      <a class="btn btn-ghost" href="/vhod/?view=register" style="color: var(--color-bg); border-color: var(--color-bg)">Създай акаунт</a>
    </div>
  </section>
</BaseLayout>

<script>
  /* Превключвателят месечно/годишно. Цените стоят в HTML-а и се подменят —
     страницата е валидна и без JavaScript, просто показва месечните. */
  const group = document.getElementById('period');
  const pro = document.querySelector<HTMLElement>('[data-price-pro]');
  const biz = document.querySelector<HTMLElement>('[data-price-biz]');
  const notes = document.querySelectorAll<HTMLElement>('[data-period-note]');

  group?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-period]');
    if (!button) return;
    const annual = button.dataset.period === 'annual';

    group.querySelectorAll<HTMLButtonElement>('[data-period]').forEach((option) => {
      option.setAttribute('aria-pressed', String((option.dataset.period === 'annual') === annual));
    });
    if (pro) pro.textContent = annual ? '1 490 лв.' : '149 лв.';
    if (biz) biz.textContent = annual ? '4 490 лв.' : '449 лв.';
    notes.forEach((note) => {
      note.textContent = annual ? 'на година, за домейн' : 'на месец, за домейн';
    });
  });
</script>
