---
import BaseLayout from '../layouts/BaseLayout.astro';

const comparison = [
  ['Кредити за период', '50', '3 000', '20 000'],
  ['Домейни', '1', '1', '10'],
  ['Следени конкуренти', '—', '3', '10 на домейн'],
  ['AI чат и инструменти', 'Да', 'Да', 'Да'],
  ['Search Console', 'Да', 'Да', 'Да'],
  ['Google Analytics 4', 'При активирана интеграция', 'При активирана интеграция', 'При активирана интеграция'],
  ['Подробен обход', 'до 50 URL на пускане', 'до 50 URL на пускане', 'до 50 URL на пускане'],
  ['Статус', 'Активен в бета', 'Предварителен', 'По заявка'],
];

const faq = [
  { q: 'Какво означава „публична бета“?', a: 'Основният продукт работи, но още събираме обратна връзка и можем да променяме лимити, модели и интерфейс. Не се извършва автоматично таксуване.' },
  { q: 'Как се харчат кредитите?', a: 'Чат съобщение струва 1 кредит, одит на страница — 2, обход на сайт — 8, а проверка на AI видимост — 10. Точната цена се показва преди изпълнение.' },
  { q: 'Мога ли да купя Pro сега?', a: 'Не през автоматично плащане. Планът е предварително обявен, за да е ясна посоката. За ранен платен достъп се свържи с нас.' },
  { q: 'Работи ли на български?', a: 'Да. Интерфейсът, анализите и генерираното съдържание са направени с фокус върху български бизнеси и заявки.' },
  { q: 'Трябва ли да свържа Google?', a: 'Не. Одитът, AI проверките и чатът работят без Google. Search Console и Analytics добавят реални позиции и трафик, когато решиш да ги свържеш.' },
  { q: 'AI видимостта гарантира ли повече продажби?', a: 'Не. Тя показва дали и как брандът присъства в проверените отговори. Това е диагностичен сигнал, а не обещание за класиране, трафик или приходи.' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })),
};
---

<BaseLayout title="Цени" current="ceni" description="Цени и лимити за SEO Bot — български SEO и GEO асистент за AI видимост, технически одит и данни от Google." schema={schema}>
  <div class="shell">
    <section style="padding: 82px 0 52px">
      <span class="tag tag-accent" style="margin-bottom: 22px">Публична бета</span>
      <h1 style="font-size: clamp(38px, 5vw, 68px); letter-spacing: -.045em; max-width: 14ch">Започваш безплатно. Без скрито таксуване.</h1>
      <p class="hero-lead" style="margin-top: 22px">В момента активният план е Free с 50 стартови кредита. Pro е предварителна оферта, а Business се активира само след разговор — плащанията в приложението още не са включени.</p>
      <p class="notice notice-ok" style="margin-top: 28px; max-width: 760px">Няма да поискаме карта и няма автоматично подновяване, докато плащанията не бъдат официално пуснати.</p>
    </section>

    <section style="padding: 12px 0 76px">
      <div class="split-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; align-items: stretch">
        <article class="card">
          <span class="kicker">Free · активен</span>
          <p style="font-weight: 800; font-size: 48px; line-height: 1; margin: 0">0 лв.</p>
          <p style="color: var(--color-neutral-700)">50 стартови кредита</p>
          <p class="card-body">За първи одит, няколко AI проверки и работа с асистента.</p>
          <a class="btn btn-primary btn-block" href="/vhod/?view=register">Създай акаунт</a>
          <ul class="plan-list"><li>1 домейн</li><li>AI чат и всички инструменти</li><li>Search Console и GA4 по избор</li><li>Одит до 50 URL на пускане</li></ul>
        </article>

        <article class="card" style="border: 2px solid var(--color-accent)">
          <span class="kicker kicker-accent">Pro · предварителен</span>
          <p style="font-weight: 800; font-size: 48px; line-height: 1; margin: 0">149 лв.</p>
          <p style="color: var(--color-neutral-700)">планирана месечна цена</p>
          <p class="card-body">За един бизнес с редовни проверки и конкурентен анализ.</p>
          <a class="btn btn-secondary btn-block" href="mailto:info@kova.bg?subject=SEO%20Bot%20Pro">Заяви ранен достъп</a>
          <ul class="plan-list"><li>3 000 кредита</li><li>1 домейн + 3 конкурента</li><li>AI видимост и сравнения</li><li>Всички налични генератори</li></ul>
        </article>

        <article class="card">
          <span class="kicker">Business · по заявка</span>
          <p style="font-weight: 800; font-size: 42px; line-height: 1; margin: 0">Индивидуално</p>
          <p style="color: var(--color-neutral-700)">активира се ръчно</p>
          <p class="card-body">За агенции и екипи с повече домейни и по-голям обем.</p>
          <a class="btn btn-secondary btn-block" href="mailto:info@kova.bg?subject=SEO%20Bot%20Business">Говори с нас</a>
          <ul class="plan-list"><li>20 000 кредита</li><li>До 10 домейна</li><li>До 10 конкурента на домейн</li><li>Настройване според нуждата</li></ul>
        </article>
      </div>
    </section>

    <section style="padding: 66px 0; border-top: 1px solid var(--color-divider)">
      <div class="section-heading"><span class="kicker kicker-accent">Точно сравнение</span><h2>Само функции, които съществуват.</h2></div>
      <div style="overflow-x: auto"><table class="table"><thead><tr><th style="width: 34%">Функция</th><th>Free</th><th>Pro</th><th>Business</th></tr></thead><tbody>{comparison.map((row) => <tr><td><strong>{row[0]}</strong></td>{row.slice(1).map((cell) => <td>{cell}</td>)}</tr>)}</tbody></table></div>
    </section>

    <section style="padding: 72px 0 96px; border-top: 1px solid var(--color-divider)">
      <div class="section-heading"><span class="kicker kicker-accent">Често задавани въпроси</span><h2>Преди да започнеш.</h2></div>
      <div class="split-2" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 64px">
        {faq.map((item) => <div><h3 style="font-size: 19px; margin-bottom: 10px">{item.q}</h3><p style="line-height: 1.7; color: var(--color-neutral-800)">{item.a}</p></div>)}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .plan-list { list-style: none; padding: 20px 0 0; margin: 20px 0 0; border-top: 1px solid var(--color-divider); display: grid; gap: 9px; font-size: 14px; }
  .plan-list li::before { content: '✓'; color: var(--color-accent); font-weight: 800; margin-right: 9px; }
</style>
