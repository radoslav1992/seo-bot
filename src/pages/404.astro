---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Страницата не е намерена" noindex>
  <div class="shell">
    <section class="error-page">
      <span class="kicker kicker-accent">Грешка 404</span>
      <h1>Тази страница не излиза в резултатите.</h1>
      <p>Адресът може да е променен или страницата да е премахната.</p>
      <div class="button-row">
        <a class="btn btn-primary" href="/">Към началото</a>
        <a class="btn btn-secondary" href="/tablo/">Към таблото</a>
      </div>
    </section>
  </div>
</BaseLayout>
