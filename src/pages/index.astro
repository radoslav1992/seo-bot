---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site.mjs';

const metrics = [
  { value: '18', label: 'специализирани SEO и GEO инструмента' },
  { value: '3', label: 'AI двигателя в началната конфигурация' },
  { value: '50', label: 'URL адреса в един подробен обход' },
  { value: 'GSC + GA4', label: 'реални данни от Google по избор' },
];

const features = [
  ['AI видимост, измерена с реални въпроси', 'SEO Bot задава заявки на настроените AI двигатели, пази отговорите и показва дали брандът ти е споменат, на коя позиция и до кои конкуренти.'],
  ['Одит, който стига до конкретно решение', 'Проверява индексиране, заглавия, schema.org, вътрешни връзки, llms.txt, достъп за AI ботове и технически сигнали. Всеки проблем идва със следваща стъпка.'],
  ['Search Console и Analytics в същия разговор', 'Свързваш Google по избор и ботът работи с реални позиции, кликове, страници и трафик — без да копираш таблици между инструменти.'],
  ['Съдържание и технически файлове', 'Генерира задания, структури, FAQ, валидна schema.org разметка и llms.txt. Кодът сглобява структурата; моделът пише само текста.'],
  ['Конкуренти от самите отговори', 'Виждаш кои домейни AI препоръчва вместо твоя и сравняваш съдържанието, структурата и техническите им сигнали със своите.'],
  ['Подреден списък за работа', 'Резултатите се превръщат в задачи с приоритет, очакван ефект и история. Не още едно табло, което трябва сам да разгадаваш.'],
];

const steps = [
  ['Добавяш домейн', 'Регистрацията е без карта. Въвеждаш сайт, който управляваш, и избираш дали да свържеш Google.'],
  ['Пускаш първата проверка', 'Ботът обхожда сайта, съставя подходящи въпроси и проверява настроените AI двигатели.'],
  ['Работиш по приоритетите', 'Получаваш обяснение, задачи и готови материали. Следващата проверка показва какво се е променило.'],
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.name,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'bg',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'BGN', description: 'Публична бета версия' },
};
---

<BaseLayout schema={schema}>
  <div class="shell">
    <section class="hero-grid">
      <div>
        <span class="kicker kicker-accent">SEO + GEO за български бизнес</span>
        <h1 class="hero-title">Разбери дали AI <em>препоръчва</em> твоя бизнес.</h1>
        <p class="hero-lead">SEO Bot събира AI видимост, технически одит и реални данни от Google в един асистент. Получаваш не просто резултат, а ясен списък какво да подобриш първо.</p>
        <div class="button-row" style="margin-top: 30px">
          <a class="btn btn-primary" href="/vhod/?view=register">Направи първа проверка</a>
          <a class="btn btn-secondary" href="#produkt">Разгледай продукта</a>
        </div>
        <p class="trust-line">50 стартови кредита · без карта · публична бета версия</p>
      </div>

      <div class="product-preview" aria-label="Примерен изглед на таблото">
        <div class="preview-top"><strong>ВИДИМОСТ · ПРИМЕР</strong><span class="preview-live">● измерено с търсене</span></div>
        <div class="preview-score"><strong>62</strong><p>Споменаване в 62% от проверените AI отговори за избраните заявки.</p></div>
        <svg class="preview-chart" viewBox="0 0 520 118" role="img" aria-label="Примерна растяща динамика">
          <g stroke="#45413d" stroke-width="1"><line x1="0" y1="18" x2="520" y2="18" /><line x1="0" y1="58" x2="520" y2="58" /><line x1="0" y1="98" x2="520" y2="98" /></g>
          <path d="M0 91 C70 88, 72 72, 138 76 S224 46, 292 59 S382 28, 520 18" fill="none" stroke="#ff4f2e" stroke-width="4" /><circle cx="514" cy="19" r="6" fill="#ff4f2e" />
        </svg>
        <div class="preview-query"><span>„счетоводна къща за малък бизнес“</span><span>Споменат</span></div>
        <div class="preview-query"><span>„добър счетоводител в София“</span><span>Позиция 2</span></div>
        <div class="preview-query"><span>„онлайн счетоводни услуги“</span><span>Задача</span></div>
      </div>
    </section>

    <section class="metric-grid" aria-label="Възможности на продукта">
      {metrics.map((metric) => <div class="metric"><strong>{metric.value}</strong><span>{metric.label}</span></div>)}
    </section>

    <section id="produkt" style="padding: 92px 0 64px">
      <div class="section-heading">
        <span class="kicker kicker-accent">Един работен поток</span>
        <h2>От „вижда ли ме AI?“ до „какво правя днес?“</h2>
        <p>Всеки резултат може да бъде проследен до одит, AI отговор или данни от Google. Ботът не измисля числа.</p>
      </div>
      {features.map((feature, index) => (
        <div class="feature-row" style={`display: grid; grid-template-columns: 90px minmax(0, 390px) minmax(0, 1fr); gap: 24px clamp(24px, 4vw, 72px); align-items: baseline; padding: 34px 0${index > 0 ? '; border-top: 1px solid var(--color-divider)' : ''}`}>
          <p class="num" style="font-weight: 800; font-size: 14px; margin: 0; color: var(--color-accent)">0{index + 1}</p>
          <h3 style="font-size: 23px; margin: 0">{feature[0]}</h3>
          <p style="font-size: 15.5px; line-height: 1.75; margin: 0; max-width: 58ch; color: var(--color-neutral-800)">{feature[1]}</p>
        </div>
      ))}
    </section>

    <section id="kak" style="padding: 72px 0 84px">
      <div class="section-heading"><span class="kicker kicker-accent">Как работи</span><h2>Първи полезен резултат в три стъпки.</h2></div>
      <div class="split-3" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px">
        {steps.map((step, index) => <div class="card"><span class="tag tag-accent" style="align-self: flex-start">0{index + 1}</span><h3 style="font-size: 21px; margin-top: 12px">{step[0]}</h3><p style="line-height: 1.7; color: var(--color-neutral-800)">{step[1]}</p></div>)}
      </div>
    </section>

    <section style="padding: 0 0 92px">
      <div class="principle-card split-2" style="display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 48px; align-items: center">
        <div><span class="kicker" style="color: var(--color-accent)">Важната разлика</span><h2 style="font-size: clamp(30px, 4vw, 48px)">Видимост не е същото като познатост.</h2></div>
        <p style="font-size: 17px; line-height: 1.75; margin: 0">SEO Bot отделя отговорите с потвърдено живо търсене от тези, които моделът дава по памет. Ако търсенето не е минало, резултатът не се представя като актуална видимост. Това пази решенията ти от красиво, но грешно число.</p>
      </div>
    </section>

    <section style="padding: 72px 0 92px; border-top: 1px solid var(--color-divider)">
      <div class="section-heading"><span class="kicker kicker-accent">Публична бета</span><h2>Започни безплатно. Плащанията още не са активни.</h2><p>Получаваш 50 стартови кредита, един домейн, AI чат, проверки и одит. Pro и Business са публикувани като посока, но няма автоматично таксуване.</p></div>
      <div class="button-row"><a class="btn btn-primary" href="/vhod/?view=register">Създай безплатен акаунт</a><a class="btn btn-secondary" href="/ceni/">Виж плановете</a></div>
    </section>
  </div>

  <section style="background: var(--color-accent); color: var(--color-bg)">
    <div class="shell" style="padding-block: 82px"><h2 style="font-size: clamp(34px, 5vw, 62px); max-width: 18ch; letter-spacing: -.04em; margin-bottom: 32px">Следващият AI отговор може да препоръча теб.</h2><a class="btn" href="/vhod/?view=register" style="background: var(--color-text); color: var(--color-bg)">Провери бранда си</a></div>
  </section>
</BaseLayout>
