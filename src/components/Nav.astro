---
interface Props { current?: string }
const { current } = Astro.props;

const links = [
  { href: '/#produkt', label: 'Продукт', id: 'produkt' },
  { href: '/#kak', label: 'Как работи', id: 'kak' },
  { href: '/ceni/', label: 'Цени', id: 'ceni' },
  { href: '/tablo/', label: 'Табло', id: 'tablo' },
  { href: '/chat/', label: 'Чат', id: 'chat' },
];
---

<nav class="nav" aria-label="Основна навигация">
  <a class="nav-brand" href="/">SEO BOT</a>
  <div class="nav-links">
    {links.map((link) => (
      <a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a>
    ))}
    <a href="/vhod/">Вход</a>
    <a class="btn btn-primary" href="/vhod/?view=register">Започни безплатно</a>
  </div>
  <details class="nav-mobile">
    <summary>Меню</summary>
    <div>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href="/vhod/">Вход</a>
      <a class="btn btn-primary" href="/vhod/?view=register">Започни безплатно</a>
    </div>
  </details>
</nav>
